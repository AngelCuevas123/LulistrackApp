# Configuracion de Supabase usada por la app movil.
# Utiliza la URL y la clave publica (anon/publishable) de tu proyecto.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_clave_publica_anon_o_publishable

# URL del backend FastAPI desplegado.
API_BASE_URL=https://tu-backend.onrender.com
